# Credenciales de Pusher Channels (https://dashboard.pusher.com).
# Crea una app gratuita, activa "Enable client events" en su configuración
# y copia estos cuatro valores. Sin ellos, la comunicación en tiempo real
# entre el monitor y los teléfonos no funciona (ver README, sección
# "Comunicación en tiempo real").

# Servidor (no se exponen al navegador)
PUSHER_APP_ID=
PUSHER_SECRET=

# Cliente y servidor (NEXT_PUBLIC_* sí se exponen al navegador; son públicos por diseño)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
